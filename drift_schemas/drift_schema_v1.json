  "fixed_sql": [
    {
      "name": "local_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_profiles\" (\"singleton\" INTEGER NOT NULL DEFAULT 1, \"device_id\" BLOB NOT NULL, \"public_key\" BLOB NOT NULL, \"display_name\" TEXT NOT NULL, \"revision\" INTEGER NOT NULL, \"created_at_micros\" INTEGER NOT NULL, \"updated_at_micros\" INTEGER NOT NULL, PRIMARY KEY (\"singleton\"), CHECK (singleton = 1));"
        }
      ]
    },
    {
      "name": "pinned_peers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pinned_peers\" (\"device_id\" BLOB NOT NULL, \"public_key\" BLOB NOT NULL, \"display_name\" TEXT NOT NULL, \"profile_revision\" INTEGER NOT NULL, \"profile_created_at_micros\" INTEGER NOT NULL, \"profile_updated_at_micros\" INTEGER NOT NULL, \"pinned_at_micros\" INTEGER NOT NULL, \"last_verified_at_micros\" INTEGER NOT NULL, \"trust_state\" TEXT NOT NULL, PRIMARY KEY (\"device_id\"));"
        }
      ]
    },
    {
      "name": "conversations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"conversations\" (\"conversation_id\" BLOB NOT NULL, \"first_participant_id\" BLOB NOT NULL, \"second_participant_id\" BLOB NOT NULL, \"created_at_micros\" INTEGER NOT NULL, PRIMARY KEY (\"conversation_id\"), UNIQUE (\"first_participant_id\", \"second_participant_id\"));"
        }
      ]
    },
    {
      "name": "operations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"operations\" (\"operation_id\" BLOB NOT NULL, \"protocol_version\" INTEGER NOT NULL, \"conversation_id\" BLOB NOT NULL, \"author_device_id\" BLOB NOT NULL, \"recipient_device_id\" BLOB NOT NULL, \"author_sequence\" INTEGER NOT NULL, \"previous_operation_id\" BLOB NULL, \"authored_at_micros\" INTEGER NOT NULL, \"message_text\" TEXT NOT NULL, \"signature\" BLOB NOT NULL, \"canonical_bytes\" BLOB NOT NULL, \"received_at_micros\" INTEGER NOT NULL, PRIMARY KEY (\"operation_id\"), UNIQUE (\"conversation_id\", \"author_device_id\", \"author_sequence\"), FOREIGN KEY (conversation_id) REFERENCES conversations(conversation_id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "feed_heads",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feed_heads\" (\"conversation_id\" BLOB NOT NULL, \"author_device_id\" BLOB NOT NULL, \"head_sequence\" INTEGER NOT NULL, \"head_operation_id\" BLOB NOT NULL, \"is_quarantined\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_quarantined\" IN (0, 1)), PRIMARY KEY (\"conversation_id\", \"author_device_id\"), FOREIGN KEY (conversation_id) REFERENCES conversations(conversation_id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "message_projections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"message_projections\" (\"operation_id\" BLOB NOT NULL, \"conversation_id\" BLOB NOT NULL, \"author_device_id\" BLOB NOT NULL, \"recipient_device_id\" BLOB NOT NULL, \"author_sequence\" INTEGER NOT NULL, \"authored_at_micros\" INTEGER NOT NULL, \"message_text\" TEXT NOT NULL, \"inserted_at_micros\" INTEGER NOT NULL, PRIMARY KEY (\"operation_id\"), FOREIGN KEY (operation_id) REFERENCES operations(operation_id) ON DELETE CASCADE, FOREIGN KEY (conversation_id) REFERENCES conversations(conversation_id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "retention_floors",
      "sql": [
